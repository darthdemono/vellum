{
  "name": "vellum",
  "version": "0.1.0",
  "description": "Small static site generator for Obsidian vaults: no server process, no runtime on the host.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Jubair Hasan",
  "repository": { "type": "git", "url": "git+https://github.com/darthdemono/vellum.git" },
  "keywords": ["static-site-generator", "obsidian", "markdown", "llms-txt"],
  "files": ["bin", "src", "assets", "examples"],
  "bin": {
    "vellum": "bin/vellum.mjs"
  },
  "scripts": {
